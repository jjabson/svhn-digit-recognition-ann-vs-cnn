# SVHN MCP HTTP authentication
#
# Copy these values into your shell environment or a local .env file.
# Never commit real bearer tokens.

SVHN_MCP_HTTP_AUTH_ENABLED=false

# Required only when HTTP authentication is enabled.
# Generate a strong value locally, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SVHN_MCP_BEARER_TOKEN=<generate-a-strong-local-secret>

# Authentication metadata.
SVHN_MCP_AUTH_ISSUER_URL=https://auth.example.test

# Local host example:
SVHN_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8001/mcp

# Docker/n8n example:
# SVHN_MCP_RESOURCE_SERVER_URL=http://host.docker.internal:8001/mcp